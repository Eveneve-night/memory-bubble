{
  "name": "dsh-memory-bubble",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "忆泡 Memory Bubble — 把 AI 日常对话沉淀成可管理、可继承的暖色记忆泡泡图",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "immediately": true
    }
  }
}
